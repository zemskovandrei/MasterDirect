PORT=3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Comma-separated list of production frontend origins allowed by CORS.
ALLOWED_ORIGINS=https://masterdirect.ge,https://www.masterdirect.ge

# Public site origin for bot profile links.
SITE_ORIGIN=https://masterdirect.ge

# Telegram bot for catalog publishing (BotFather token).
# Leave empty to disable the bot.
TELEGRAM_BOT_TOKEN=

# Optional. On Railway, webhook URL is auto-built from RAILWAY_PUBLIC_DOMAIN.
# Locally leave empty to use long-polling (do not run local + Railway together).
# TELEGRAM_WEBHOOK_URL=https://YOUR-SERVICE.up.railway.app/api/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=long-random-string

# Comma-separated admin emails used by API role checks.
ADMIN_EMAILS=admin@smartbuild.tech

# Basic API rate limiting.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
